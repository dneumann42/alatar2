use base
use math
use strings
use io
use gui
use widgets

; The app state is plain bindings: a reload keeps their values, so it
; survives editing this file or patching it from an attached repl.
clicks = 0
dark = true

; Called every frame. Redefine it (save the file, or type a new fun view
; into an attached repl) and the next frame shows it.
fun view:
    handle-events:
        event Bumped e:
            set clicks (+ clicks e.by)
        column (width = grow) (height = grow) (gap = 16) (bg = "bg"):
            heading "Nomicon" 1
            caption "Edit src/main.owl and save, or run owl repl, then run."

run-app (title = "nomicon"):
    (view)
