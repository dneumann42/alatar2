use base
use math
use strings
use gui
export all

; Widgets of the app. Documents the repl saves into src/ join the uses
; of main the same way.

; A count with a button that asks for more. It does not change the count
; itself: it emits Bumped, and whoever holds the count catches it.
widget Counter id label n:
    emits Bumped by
    row (gap = 12) (align-y = "center"):
        text (concat label ": " (to-string n))
        when (button (concat id ".more") "+1"):
            emit Bumped (by = 1)
