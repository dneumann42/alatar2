{#
  yazi flavor generated by wallust - DO NOT EDIT the rendered file.
  Re-rendered into ~/.config/yazi/flavors/wallust.yazi/flavor.toml on every
  wallpaper change (set-wallpaper.sh runs `wallust run`; apply-wallpaper.sh
  does it at every sway session start). Yazi reads flavors at startup, so a
  running instance keeps its colors until restarted - no reload hook wired.
  Same scheme as the sway and opencode templates: the background is pinned to
  black, surfaces are color8 pulled toward that black (never lightened off
  it, so fg-on-surface contrast survives), and the salience hues fill the
  accent roles - with sampling=high + check_contrast they land above 4:1 on
  black, and #000000 labels on them keep the same ratio. A missing flavor
  file just means yazi falls back to its built-in default colors.
#}
# vim:fileencoding=utf-8:foldmethod=marker
{#
  ROUNDED CORNERS TODO: yazi <= 26.9.1 hardcodes the ╭╮╰╯ corners on floating
  windows; there is NO theme key that changes them. Upstream main added
  `border_set` per float section. Once a release containing it is installed
  (e.g. yazi-git, or the next stable), uncomment the border_set lines below in
  every float section to get square corners.
#}

# : Manager --

[mgr]
cwd = { fg = "{{ color6 }}" }

# Find
find_keyword  = { fg = "{{ color3 }}", bold = true, italic = true, underline = true }
find_position = { fg = "{{ color5 }}", bg = "reset", bold = true, italic = true }

# Marker
marker_copied   = { fg = "{{ color2 }}", bg = "{{ color2 }}" }
marker_cut      = { fg = "{{ color1 }}", bg = "{{ color1 }}" }
marker_marked   = { fg = "{{ color6 }}", bg = "{{ color6 }}" }
marker_selected = { fg = "{{ color3 }}", bg = "{{ color3 }}" }

# Count
count_copied   = { fg = "#000000", bg = "{{ color2 }}" }
count_cut      = { fg = "#000000", bg = "{{ color1 }}" }
count_selected = { fg = "#000000", bg = "{{ color3 }}" }

# Border
border_symbol = "│"
border_style  = { fg = "{{ color8 | blend('#000000') }}" }

# : ---


# : Tabs --

[tabs]
active   = { fg = "#000000", bg = "{{ color4 }}", bold = true }
inactive = { fg = "{{ color4 }}", bg = "{{ color8 | blend('#000000') | blend('#000000') }}" }

# : ---


# : Mode --

[mode]

normal_main = { fg = "#000000", bg = "{{ color4 }}", bold = true }
normal_alt  = { fg = "{{ color4 }}", bg = "{{ color8 | blend('#000000') }}" }

# Select mode
select_main = { fg = "#000000", bg = "{{ color6 }}", bold = true }
select_alt  = { fg = "{{ color6 }}", bg = "{{ color8 | blend('#000000') }}" }

# Unset mode
unset_main = { fg = "#000000", bg = "{{ color1 }}", bold = true }
unset_alt  = { fg = "{{ color1 }}", bg = "{{ color8 | blend('#000000') }}" }

# : ---


# : Status bar --

[status]
# Permissions
perm_sep   = { fg = "{{ color8 }}" }
perm_type  = { fg = "{{ color4 }}" }
perm_read  = { fg = "{{ color3 }}" }
perm_write = { fg = "{{ color1 }}" }
perm_exec  = { fg = "{{ color2 }}" }

# Progress
progress_label  = { fg = "{{ foreground }}", bold = true }
progress_normal = { fg = "{{ color2 }}", bg = "{{ color8 | blend('#000000') | blend('#000000') }}" }
progress_error  = { fg = "{{ color3 }}", bg = "{{ color1 }}" }

# : ---


# : Pick --

[pick]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border   = { fg = "{{ color4 }}" }
active   = { fg = "{{ color5 }}", bold = true }
inactive = {}

# : ---


# : Input --

[input]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border   = { fg = "{{ color4 }}" }
title    = {}
value    = {}
selected = { reversed = true }

# : ---


# : Completion --

[cmp]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border = { fg = "{{ color4 }}" }

# : ---


# : Tasks --

[tasks]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border  = { fg = "{{ color4 }}" }
title   = {}
hovered = { fg = "{{ color5 }}", bold = true }

# : ---


# : Which --

[which]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border          = { fg = "{{ color4 }}" }
cand            = { fg = "{{ color6 }}" }
rest            = { fg = "{{ foreground | blend(color8) }}" }
desc            = { fg = "{{ color5 }}" }
separator       = "  "
separator_style = { fg = "{{ color8 | blend('#000000') }}" }

# : ---


# : Help --

[help]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border  = { fg = "{{ color4 }}" }
action  = { fg = "{{ color6 }}" }
chord   = { fg = "{{ color5 }}" }
hovered = { reversed = true, bold = true }

# : ---


# : Spotter --

[spot]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
border   = { fg = "{{ color4 }}" }
title    = { fg = "{{ color4 }}" }
tbl_col  = { fg = "{{ color6 }}" }
tbl_cell = { fg = "{{ color5 }}", bg = "{{ color8 | blend('#000000') }}" }

# : ---


# : Notification --

[notify]
# border_set = { as = "plain" }   # TODO: uncomment on yazi with border_set support
title_info  = { fg = "{{ color2 }}" }
title_warn  = { fg = "{{ color3 }}" }
title_error = { fg = "{{ color1 }}" }

# : ---


# : File-specific styles --

[filetype]

rules = [
	# Image
	{ mime = "image/*", fg = "{{ color6 }}" },
	# Media
	{ mime = "{audio,video}/*", fg = "{{ color3 }}" },
	# Archive
	{ mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ color5 }}" },
	# Document
	{ mime = "application/{pdf,doc,rtf}", fg = "{{ color2 }}" },
	# Fallback
	{ url = "*", fg = "{{ foreground }}" },
	{ url = "*/", fg = "{{ color4 }}" },
]

# : ---
