# ============================================================================
# mako theme generated by wallust - DO NOT EDIT.
# Re-rendered into ~/.cache/wallust/mako.conf on every wallpaper change
# (set-wallpaper.sh runs `wallust run`); sway starts mako with
# `--config ~/.cache/wallust/mako.conf` (applications.conf) and the wallust
# hook runs `makoctl reload` after each generation, so new notifications
# come out of the box already themed.
# Source template: ~/.config/wallust/templates/mako.conf.j2
# ============================================================================

# Bind left click to the notification's default action. mako resolves the
# default action to one named "default" (default_action_names), which is what
# downloads-watch declares for its "Move them" answer - so clicking anywhere
# on the reminder moves the files. The button stays available as the explicit
# path. Middle/right click keep mako's own defaults.
on-button-left=invoke-default-action

# Icons are downscaled to fit this box (default 64). The wallust theme hook
# attaches a rendered 8x2 palette swatch grid (24px cells -> 192x48) so the
# notification shows the new colors; let it through undiminished while
# keeping it modest next to the text.
max-icon-size=192

# Palette body: background pinned to black (alpha keeps it translucent over
# the wallpaper), light text, grey for low urgency, red blend for critical.
# Sections are mako CRITERIA blocks ([key=value] matching the notification
# field), not named groups - `[urgency_low]` is rejected outright.
background-color=#000000{{ alpha | alpha_hexa }}
text-color={{ foreground }}

[urgency=low]
text-color={{ foreground | blend(color8) }}

[urgency=critical]
background-color={{ "#000000" | blend("#f38ba8") }}
text-color={{ foreground }}
