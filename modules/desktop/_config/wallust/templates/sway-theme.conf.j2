# ============================================================================
# sway theme generated by wallust - DO NOT EDIT.
# Re-rendered into ~/.cache/wallust/sway-theme.conf on every wallpaper change
# (set-wallpaper.sh runs `wallust run`, which then reloads sway); sway reads
# it through the `include $HOME/.cache/wallust/sway-*.conf` glob in
# appearance.conf. These `set`s re-define appearance.conf's defaults, and
# sway substitutes the variables where they are used - the client.* lines
# and bar.conf both follow. No trailing comments: sway cannot have them.
# Source template: ~/.config/wallust/templates/sway-theme.conf.j2
# ============================================================================

# Background is pinned to black by design (wallust has no config knob for
# it, and the salience dark anchor lands on a tinted near-black otherwise);
# surfaces and accents below still ride the wallpaper's colors.
set $background   #000000
set $background2  {{ color0 | blend(color8) }}
set $surface      {{ color8 }}
set $surface_alt  {{ color8 | lighten(0.2) }}
set $text         {{ foreground }}
set $muted        {{ foreground | blend(color8) }}
# Accents ride the image's own hues (salience makes no red/blue promises);
# urgent stays the repo's fixed red so it always reads as alarming.
set $accent       {{ color4 }}
set $accent2      {{ color2 | lighten(0.1) }}
set $urgent       #f38ba8
set $inactive     {{ color8 }}

# Bar: $bar_bg is the bar window background with the config's alpha (wallpaper
# shows through), $bar_flat fills the active workspace pill. The alpha byte is
# assembled by hand: the `hexa` filter in v4.1.0-alpha renders the rgb as
# *decimal* components (#000D9 instead of #000000D9), so it is unusable here.
set $bar_flat     #000000
set $bar_bg       #000000{{ alpha | alpha_hexa }}
