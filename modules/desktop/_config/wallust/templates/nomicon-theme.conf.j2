{#
  nomicon theme generated by wallust - DO NOT EDIT the rendered file.
  Re-rendered into ~/.cache/wallust/nomicon-theme.conf on every wallpaper
  change (set-wallpaper.sh runs `wallust run`); nomicon re-reads that file
  every frame and reparses when its text changes, so a running window
  repaints on its next frame - no hook needed, and killing the
  quick-settings window from a palette hook would be rude, so none is
  wired.
  Format: `role = #rrggbb`, prefixed `dark.` / `light.` (nomicon's Dark
  Style toggle picks the half). Comment lines and unknown keys are ignored;
  roles that are absent keep nomicon's built-in gothic fallback - the
  beyond palette (bronze fillets, parchment ink).
  Rules, same as the sway and kitty templates: the background is pinned to
  black, surfaces are color8 pulled *toward* that black (color8 is a mid
  tone, light text sitting bare on it fell to 1.6:1 in the bar), and the
  chromatic slots ride the image's own hues - salience makes no red/blue
  promises. color1 is the gilt band (the gothic bronze role: borders,
  hover, selection, scrollbar), color2 the seal (accent: focus rings,
  links, active fills). With sampling=high + check_contrast, color2 lands
  above 4:1 on black, so black ink pinned on it stays readable.
  The shadow and scrollbar alpha are not wallust's business: nomicon adds
  them around panel_border and bg itself.
#}
# ============================================================================
# nomicon gothic theme generated by wallust - DO NOT EDIT.
# Source template: ~/.config/wallust/templates/nomicon-theme.conf.j2
# ============================================================================

# --- dark: the crypt, lit by the wallpaper's own fire -----------------------
dark.bg                = #000000
dark.panel_bg          = {{ color8 | blend('#000000') | blend('#000000') }}
dark.panel_border      = {{ color1 | darken(0.45) }}
dark.button_bg         = {{ color8 | blend('#000000') }}
dark.button_hover_bg   = {{ color1 | darken(0.28) }}
dark.button_press_bg   = {{ color0 | darken(0.5) }}
dark.field_bg          = {{ color0 | blend('#000000') }}
dark.selected_bg       = {{ color1 | darken(0.35) }}
dark.accent            = {{ color2 }}
dark.text_color        = {{ foreground }}
dark.dim_color         = {{ color8 }}
dark.label_color       = {{ foreground | blend(color8) }}
dark.on_accent         = #000000

# --- light: the vellum hall, same gilt, same seal ----------------------------
# Roles invert: paper surfaces rise from the foreground toward white, ink
# sinks from color8 toward black, and the seal darkens so pale ink on it
# keeps its contrast on the bright face.
light.bg               = {{ foreground | blend('#ffffff') }}
light.panel_bg         = {{ foreground }}
light.panel_border     = {{ color1 | darken(0.3) }}
light.button_bg        = {{ foreground | blend(color8) | blend('#ffffff') }}
light.button_hover_bg  = {{ color1 | lighten(0.25) }}
light.button_press_bg  = {{ color8 | blend('#000000') }}
light.field_bg         = #ffffff
light.selected_bg      = {{ color1 | lighten(0.1) }}
light.accent           = {{ color2 | blend('#000000') }}
light.text_color       = {{ color8 | blend('#000000') | blend('#000000') | blend('#000000') }}
light.dim_color        = {{ color8 | darken(0.25) }}
light.label_color      = {{ color8 | blend('#000000') }}
light.on_accent        = {{ foreground | blend('#ffffff') }}
