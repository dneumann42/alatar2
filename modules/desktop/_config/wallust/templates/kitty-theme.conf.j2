# ============================================================================
# kitty theme generated by wallust - DO NOT EDIT.
# Re-rendered into ~/.cache/wallust/kitty-theme.conf on every wallpaper change
# (set-wallpaper.sh runs `wallust run`); kitty reads it through the absolute
# include at the end of kitty/kitty.conf, so these values override the
# defaults there. Existing windows need a config reload (ctrl+shift+f5);
# new ones are themed.
# Source template: ~/.config/wallust/templates/kitty-theme.conf.j2
# ============================================================================

background            #000000
foreground            {{ foreground }}

color0  {{ color0 }}
color1  {{ color1 }}
color2  {{ color2 }}
color3  {{ color3 }}
color4  {{ color4 }}
color5  {{ color5 }}
color6  {{ color6 }}
color7  {{ color7 }}
color8  {{ color8 }}
color9  {{ color9 }}
color10 {{ color10 }}
color11 {{ color11 }}
color12 {{ color12 }}
color13 {{ color13 }}
color14 {{ color14 }}
color15 {{ color15 }}

# The `cursor` variable is wallust's own blend of the foreground with the
# accent slot, so it stays visible on the background whatever the wallpaper
# does; `color4` alone used to land at 1.4:1 on black.
cursor            {{ cursor }}
cursor_text_color #000000

selection_foreground #000000
selection_background {{ color6 | lighten(0.15) }}

url_color {{ color6 }}

# Tab backgrounds are surfaces, not tints: light text on a bare color8
# measured 1.4-2.3:1 (see the sway template's note), so pull color8 toward
# the pinned black instead of lightening it.
active_tab_foreground   {{ foreground }}
active_tab_background   {{ color8 | blend('#000000') | blend('#000000') }}
inactive_tab_foreground {{ foreground | blend(color8) }}
inactive_tab_background {{ color0 | blend('#000000') }}
