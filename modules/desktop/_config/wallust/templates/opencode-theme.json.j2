{#
  opencode theme generated by wallust - DO NOT EDIT the rendered file.
  Re-rendered into ~/.config/opencode/themes/wallust.json on every wallpaper
  change (the file's name is the theme's name; cli.json selects it). A running
  TUI picks the new colors up on its next start; OpenCode reads themes at
  startup and there is no reload hook for one (killing the user's session from
  a palette hook would be rude - so none is wired).
  Schema: base = every semantic token (references resolve against the active
  mode's hues), dark = the complete hue palette. Rules, same as the sway and
  emacs templates: background is pinned to black, the salience colors (which
  carry no red/blue promise, can even land near-black, and repeat in the
  bright slots) fill the accent/chromatic roles, red/green/yellow stay static
  so error, success and warning always read alike.
  Ramps: 100 is the lightest step (dark mode runs light->dark). The text-
  facing steps of palette-driven hues (100-300) mix hard toward white, so
  even a near-black salience anchor stays readable on the black background;
  only surface/fill roles (600-900) sink into the darks.
#}
{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["accent", "interactive", "purple", "cyan", "blue", "orange", "green", "red", "yellow"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "faint": "$hue.neutral.500",
      "action": {
        "primary": {
          "base": "$hue.interactive.200",
          "$hovered": "$hue.interactive.100",
          "$focused": "$hue.interactive.100",
          "$selected": "$hue.interactive.100",
          "$disabled": "$hue.neutral.500"
        },
        "secondary": {
          "base": "$hue.neutral.400",
          "$hovered": "$hue.neutral.200",
          "$disabled": "$hue.neutral.600"
        },
        "destructive": {
          "base": "$hue.red.300",
          "$hovered": "$hue.red.200",
          "$disabled": "$hue.neutral.500"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.300",
        "$selected": "$hue.interactive.200",
        "$disabled": "$hue.neutral.500"
      },
      "feedback": {
        "error": { "base": "$hue.red.300", "muted": "$hue.red.500" },
        "warning": { "base": "$hue.yellow.300", "muted": "$hue.yellow.500" },
        "success": { "base": "$hue.green.300", "muted": "$hue.green.500" },
        "info": { "base": "$hue.blue.200", "muted": "$hue.blue.400" }
      }
    },
    "background": {
      "base": "#000000",
      "raised": {
        "base": "$hue.neutral.800",
        "high": "$hue.neutral.700",
        "max": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "base": "$hue.interactive.600",
          "$hovered": "$hue.interactive.500",
          "$focused": "$hue.interactive.500",
          "$pressed": "$hue.interactive.700",
          "$selected": "$hue.interactive.500",
          "$disabled": "$hue.neutral.700"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.neutral.700",
          "$pressed": "$hue.neutral.800",
          "$selected": "$hue.neutral.700",
          "$disabled": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.red.600",
          "$hovered": "$hue.red.500",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$hue.neutral.900",
        "$hovered": "$hue.neutral.800",
        "$focused": "$hue.neutral.700",
        "$pressed": "$hue.neutral.700",
        "$selected": "$hue.neutral.700",
        "$disabled": "$hue.neutral.800"
      },
      "feedback": {
        "error": { "base": "$hue.red.800" },
        "warning": { "base": "$hue.yellow.800" },
        "success": { "base": "$hue.green.800" },
        "info": { "base": "$hue.blue.800" }
      }
    },
    "border": { "base": "$hue.neutral.600" },
    "scrollbar": { "base": "$hue.neutral.500" },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.blue.200"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.500",
        "removed": "$hue.red.500"
      },
      "lineNumber": {
        "text": "$hue.neutral.500",
        "background": {
          "added": "$hue.green.700",
          "removed": "$hue.red.700"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.500",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.cyan.200",
      "string": "$hue.accent.200",
      "number": "$hue.orange.200",
      "type": "$hue.yellow.300",
      "operator": "$hue.red.300",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.accent.200",
      "link": "$hue.cyan.200",
      "linkText": "$hue.accent.200",
      "code": "$hue.orange.200",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.purple.200",
      "strong": "$hue.yellow.200",
      "horizontalRule": "$hue.neutral.600",
      "listItem": "$hue.accent.300",
      "listEnumeration": "$hue.interactive.200",
      "image": "$hue.green.300",
      "imageText": "$hue.green.200",
      "codeBlock": "$hue.neutral.300"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "{{ foreground | lighten(0.15) }}",
        "200": "{{ foreground }}",
        "300": "{{ foreground | blend(color8) }}",
        "400": "{{ color8 | lighten(0.15) }}",
        "500": "{{ color8 }}",
        "600": "{{ color8 | darken(0.35) }}",
        "700": "{{ color8 | blend(color0) }}",
        "800": "{{ color8 | darken(0.7) }}",
        "900": "{{ color0 | darken(0.3) }}"
      },
      "neutral": "$hue.gray",
      "accent": {
        "100": "{{ color1 | lighten(0.65) }}",
        "200": "{{ color1 | lighten(0.45) }}",
        "300": "{{ color1 | lighten(0.28) }}",
        "400": "{{ color1 }}",
        "500": "{{ color1 | darken(0.12) }}",
        "600": "{{ color1 | darken(0.28) }}",
        "700": "{{ color1 | darken(0.45) }}",
        "800": "{{ color1 | darken(0.62) }}",
        "900": "{{ color1 | darken(0.8) }}"
      },
      "interactive": {
        "100": "{{ color2 | lighten(0.65) }}",
        "200": "{{ color2 | lighten(0.45) }}",
        "300": "{{ color2 | lighten(0.28) }}",
        "400": "{{ color2 }}",
        "500": "{{ color2 | darken(0.12) }}",
        "600": "{{ color2 | darken(0.28) }}",
        "700": "{{ color2 | darken(0.45) }}",
        "800": "{{ color2 | darken(0.62) }}",
        "900": "{{ color2 | darken(0.8) }}"
      },
      "orange": {
        "100": "{{ color3 | lighten(0.65) }}",
        "200": "{{ color3 | lighten(0.45) }}",
        "300": "{{ color3 | lighten(0.28) }}",
        "400": "{{ color3 }}",
        "500": "{{ color3 | darken(0.12) }}",
        "600": "{{ color3 | darken(0.28) }}",
        "700": "{{ color3 | darken(0.45) }}",
        "800": "{{ color3 | darken(0.62) }}",
        "900": "{{ color3 | darken(0.8) }}"
      },
      "blue": {
        "100": "{{ color4 | lighten(0.65) }}",
        "200": "{{ color4 | lighten(0.45) }}",
        "300": "{{ color4 | lighten(0.28) }}",
        "400": "{{ color4 }}",
        "500": "{{ color4 | darken(0.12) }}",
        "600": "{{ color4 | darken(0.28) }}",
        "700": "{{ color4 | darken(0.45) }}",
        "800": "{{ color4 | darken(0.62) }}",
        "900": "{{ color4 | darken(0.8) }}"
      },
      "purple": {
        "100": "{{ color5 | lighten(0.65) }}",
        "200": "{{ color5 | lighten(0.45) }}",
        "300": "{{ color5 | lighten(0.28) }}",
        "400": "{{ color5 }}",
        "500": "{{ color5 | darken(0.12) }}",
        "600": "{{ color5 | darken(0.28) }}",
        "700": "{{ color5 | darken(0.45) }}",
        "800": "{{ color5 | darken(0.62) }}",
        "900": "{{ color5 | darken(0.8) }}"
      },
      "cyan": {
        "100": "{{ color6 | lighten(0.65) }}",
        "200": "{{ color6 | lighten(0.45) }}",
        "300": "{{ color6 | lighten(0.28) }}",
        "400": "{{ color6 }}",
        "500": "{{ color6 | darken(0.12) }}",
        "600": "{{ color6 | darken(0.28) }}",
        "700": "{{ color6 | darken(0.45) }}",
        "800": "{{ color6 | darken(0.62) }}",
        "900": "{{ color6 | darken(0.8) }}"
      },
      "red": {
        "100": "{{ '#f38ba8' | lighten(0.45) }}",
        "200": "{{ '#f38ba8' | lighten(0.25) }}",
        "300": "#f38ba8",
        "400": "{{ '#f38ba8' | darken(0.08) }}",
        "500": "{{ '#f38ba8' | darken(0.18) }}",
        "600": "{{ '#f38ba8' | darken(0.3) }}",
        "700": "{{ '#f38ba8' | darken(0.45) }}",
        "800": "{{ '#f38ba8' | darken(0.6) }}",
        "900": "{{ '#f38ba8' | darken(0.75) }}"
      },
      "yellow": {
        "100": "{{ '#f9e2af' | lighten(0.45) }}",
        "200": "{{ '#f9e2af' | lighten(0.25) }}",
        "300": "#f9e2af",
        "400": "{{ '#f9e2af' | darken(0.08) }}",
        "500": "{{ '#f9e2af' | darken(0.18) }}",
        "600": "{{ '#f9e2af' | darken(0.3) }}",
        "700": "{{ '#f9e2af' | darken(0.45) }}",
        "800": "{{ '#f9e2af' | darken(0.6) }}",
        "900": "{{ '#f9e2af' | darken(0.75) }}"
      },
      "green": {
        "100": "{{ '#a6e3a1' | lighten(0.45) }}",
        "200": "{{ '#a6e3a1' | lighten(0.25) }}",
        "300": "#a6e3a1",
        "400": "{{ '#a6e3a1' | darken(0.08) }}",
        "500": "{{ '#a6e3a1' | darken(0.18) }}",
        "600": "{{ '#a6e3a1' | darken(0.3) }}",
        "700": "{{ '#a6e3a1' | darken(0.45) }}",
        "800": "{{ '#a6e3a1' | darken(0.6) }}",
        "900": "{{ '#a6e3a1' | darken(0.75) }}"
      }
    }
  }
}
