;;; wallust.el --- wallpaper-derived theme, generated by wallust -*- lexical-binding: t; -*-
;;
;; DO NOT EDIT - rewritten by `wallust run' on every wallpaper change
;; (desktop/theming module; source template:
;; ~/.config/wallust/templates/emacs-theme.el.j2).
;; Generated from: {{ wallpaper | basename }} ({{ palette }} palette)

(deftheme wallust
  "Palette generated by wallust from {{ wallpaper | basename }}.")

(let ((class '((class color) (min-colors 89)))
      ;; Background is pinned to black by design (see the sway/mako
      ;; templates); everything else rides the wallpaper palette.
      (bg      "#000000")
      (fg      "{{ foreground }}")
      ;; color0 is the palette's dark anchor, but "dark" is relative - it
      ;; lands anywhere from 1.05:1 to 2.06:1 against the pinned black, so
      ;; dim grey text on it can end up at ~1.2:1 (mode-line-inactive).
      ;; Pulling it halfway to black keeps it a tinted raised surface.
      (black   "{{ color0 | blend('#000000') }}")
      ;; lighten(0.1): raw color8 sits at 4.05:1 on black at worst, just under
      ;; the AA text floor for the comment face; this lands it at 4.74 while
      ;; staying clearly dimmer than the foreground (7.15+).
      (grey    "{{ color8 | lighten(0.1) }}")
      ;; `grey` (color8) is a mid tone: right as a dim *foreground*
      ;; (comments, borders, glyphs) but useless as a *background* - the
      ;; light foreground on bare color8 sat at 1.6:1, and color0 against the
      ;; pinned black was invisible (1.05:1). `surf` is the color8 tint
      ;; pulled toward that black: still reads as wallpaper-colored, keeps
      ;; text on it above 6:1. Same math as the sway template's surfaces.
      (surf    "{{ color8 | blend('#000000') | blend('#000000') }}")
      (white   "{{ color7 }}")
      ;; The salience palette gathers the image's prominent colors - these
      ;; carry its hues, with no red/blue role promise (that's what makes
      ;; every wallpaper's theme look like itself).
      (acc1    "{{ color1 }}")
      (acc2    "{{ color2 }}")
      (acc3    "{{ color3 }}")
      (acc4    "{{ color4 }}")
      (acc5    "{{ color5 }}")
      (acc6    "{{ color6 }}")
      ;; Semantic slots stay fixed so meaning survives any palette: red is
      ;; always alarming, green always good, yellow always a warning.
      (err     "#f38ba8")
      (warn    "#f9e2af")
      (ok      "#a6e3a1"))
  (custom-theme-set-faces
   'wallust
   `(default              ((t (:background ,bg :foreground ,fg))))
   `(bold                 ((t (:weight bold))))
   `(italic               ((t (:slant italic))))
   `(cursor               ((t (:background ,acc4))))
   `(mouse                ((t (:background ,acc6))))
   `(fringe               ((t (:background ,bg :foreground ,grey))))
   `(border               ((t (:background ,bg))))
   `(vertical-border      ((t (:foreground ,grey))))
   `(window-divider       ((t (:foreground ,grey))))
   `(mode-line            ((t (:background ,surf :foreground ,fg :box nil))))
   `(mode-line-inactive   ((t (:background ,black :foreground ,grey :box nil))))
   `(mode-line-buffer-id  ((t (:weight bold :foreground ,acc3))))
   `(region               ((t (:background ,surf))))
   `(secondary-region     ((t (:background ,surf))))
   `(highlight            ((t (:background ,surf))))
   `(hl-line              ((t (:background ,surf))))
   `(isearch              ((t (:background ,warn :foreground ,bg))))
   `(isearch-fail         ((t (:background ,err :foreground ,bg))))
   `(lazy-highlight       ((t (:background ,surf :foreground ,fg))))
   `(link                 ((t (:foreground ,acc6 :underline t))))
   `(link-visited         ((t (:foreground ,acc5 :underline t))))
   `(success              ((t (:foreground ,ok :weight bold))))
   `(warning              ((t (:foreground ,warn :weight bold))))
   `(error                ((t (:foreground ,err :weight bold))))
   `(minibuffer-prompt    ((t (:foreground ,acc4 :weight bold))))
   `(escape-glyph         ((t (:foreground ,grey))))
   `(nobreak-space        ((t (:foreground ,grey :underline t))))
   `(font-lock-builtin-face          ((t (:foreground ,acc6))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,grey))))
   `(font-lock-comment-face          ((t (:foreground ,grey :slant italic))))
   `(font-lock-constant-face         ((t (:foreground ,acc5))))
   `(font-lock-doc-face              ((t (:foreground ,acc2 :slant italic))))
   `(font-lock-function-name-face    ((t (:foreground ,acc4 :weight bold))))
   `(font-lock-keyword-face          ((t (:foreground ,acc5 :weight bold))))
   `(font-lock-preprocessor-face     ((t (:foreground ,acc6))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,grey))))
   `(font-lock-regexp-grouping-construct ((t (:foreground ,acc4 :weight bold))))
   `(font-lock-string-face           ((t (:foreground ,acc2))))
   `(font-lock-type-face             ((t (:foreground ,acc3))))
   `(font-lock-variable-name-face    ((t (:foreground ,acc6))))
   `(font-lock-warning-face          ((t (:foreground ,err :weight bold))))
   `(diff-added          ((t (:foreground ,ok))))
   `(diff-removed        ((t (:foreground ,err))))
   `(diff-refine-added   ((t (:background ,ok :foreground ,bg))))
   `(diff-refine-removed ((t (:background ,err :foreground ,bg)))))
  (custom-theme-set-variables
   'wallust
   `(ansi-color-names-vector [,black ,acc1 ,acc2 ,acc3 ,acc4 ,acc5 ,acc6 ,white])
   `(ansi-color-faces-vector [default bold shadow italic () bold () bold])))

(provide-theme 'wallust)

;;; wallust.el ends here
