# Copy to .env to override alatar bootstrap settings (sourced by ./setup).

# Pinned Nim version. A version change replaces the previous installation
# (including one left by choosenim) and re-links the toolchain into the
# user-global bin dir.
#NIM_VERSION=2.2.12

# Override the toolchain download URL entirely.
#NIM_URL=https://nim-lang.org/download/nim-2.2.12-linux_x64.tar.xz

# Toolchain directory (wiped/replaced on version change).
#NIM_SETUP_DIR=$HOME/.local/share/nim

# User-global bin dir where nim/nimble/... are symlinked (must be on PATH).
#NIM_USER_BIN=$HOME/.local/bin
